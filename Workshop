            </div>

            <div class="form-group">
                <label><span class="required">*</span> كيف تقيّم التنظيم والبيئة الحضورية للورشة؟</label>
                <div class="radio-group">
                    <label class="radio-option"><input type="radio" name="evaluation" value="ضعيف" required> ضعيف</label>
                    <label class="radio-option"><input type="radio" name="evaluation" value="متوسط"> متوسط</label>
                    <label class="radio-option"><input type="radio" name="evaluation" value="جيد"> جيد</label>
                    <label class="radio-option"><input type="radio" name="evaluation" value="جيد جداً"> جيد جداً</label>
                    <label class="radio-option"><input type="radio" name="evaluation" value="ممتاز"> ممتاز</label>
                </div>
            </div>

            <div class="form-group">
                <label><span class="required">*</span> ما هي مقترحاتك للورش الحضورية القادمة؟</label>
                <textarea name="futureTopics" rows="3" placeholder="اكتب مقترحاتك هنا..." required 
                          oninvalid="this.setCustomValidity('يرجى ملء هذا الحقل لإتمام الخطوة بنجاح 📋')" oninput="this.setCustomValidity('')"></textarea>
            </div>

            <div class="form-group">
                <label><span class="required">*</span> ما هو رأيك في منصة وفعاليات BIOMEDHUB؟ <a href="https://biomedhubiq.com" target="_blank" style="color: #6366f1;">https://biomedhubiq.com</a></label>
                <textarea name="platformFeedback" rows="3" placeholder="رأيك يهمنا..." required 
                          oninvalid="this.setCustomValidity('يرجى ملء هذا الحقل لإتمام الخطوة بنجاح 📋')" oninput="this.setCustomValidity('')"></textarea>
            </div>

            <button type="submit" class="submit-btn" id="submitBtn">تسجيل الحضور الحضوري</button>
            <div id="loadingMsg">جاري إرسال البيانات وحفظها... ⏳</div>
        </form>
    </div>
</div>

<script>
    // جلب عنوان الورشة المحفوظ محلياً إن وجد
    const savedWorkshopTitle = localStorage.getItem('workshop_title_key');
    if (savedWorkshopTitle) {
        document.getElementById('workshopTitle').innerText = 'استمارة حضور ورشة: ' + savedWorkshopTitle;
    }

    // ضع رابط الـ Google Apps Script الجديد الخاص بالشيت الحضورية هنا بين العلامتين:
    const scriptURL = 'ضع_رابط_الشيت_الحضورية_الجديد_هنا';

    const form = document.getElementById('attendanceForm');
    const submitBtn = document.getElementById('submitBtn');
    const loadingMsg = document.getElementById('loadingMsg');

    form.addEventListener('submit', e => {
        e.preventDefault();
        
        submitBtn.style.display = 'none';
        loadingMsg.style.display = 'block';

        const formData = new FormData(form);
        const dataObj = {};
        formData.forEach((value, key) => (dataObj[key] = value));
        dataObj['workshopName'] = document.getElementById('workshopTitle').innerText;
        dataObj['attendanceType'] = 'حضوري (Offline)';

        fetch(scriptURL, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: new URLSearchParams(dataObj)
        })
        .then(() => {
            alert('تم تسجيل حضورك الحضوري بنجاح! شكراً لحضورك 🌸');
            form.reset();
            submitBtn.style.display = 'block';
            loadingMsg.style.display = 'none';
        })
        .catch(error => {
            console.error('Error!', error);
            alert('حدث خطأ أثناء الإرسال، يرجى المحاولة مرة أخرى.');
            submitBtn.style.display = 'block';
            loadingMsg.style.display = 'none';
        });
    });
</script>

