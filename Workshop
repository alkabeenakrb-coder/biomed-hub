                <input type="text" name="university" placeholder="جامعة بغداد / مستشفى..." required 
                       oninvalid="this.setCustomValidity('يرجى ملء هذا الحقل لإتمام الخطوة بنجاح 📋')" oninput="this.setCustomValidity('')">
            </div>

            <div class="form-group">
                <label><span class="required">*</span> المرحلة الدراسية أو التخصص الوظيفي</label>
                <input type="text" name="stage" placeholder="مثال: المرحلة الرابعة / مهندس أجهزة طبية" required 
